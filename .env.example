# =======================================================
# Quotex M1 Signal Bot — Environment Configuration
# =======================================================

# Market Data API
API_BASE_URL=https://quotexfeed.lovable.app

# Database (Leave blank for local SQLite file, or paste Railway PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Telegram Bot Credentials
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID (User ID or Channel ID, e.g. -1003501100081)
TELEGRAM_CHAT_ID=

# Timing & Regional Display
DISPLAY_TIMEZONE=Asia/Karachi
CANDLE_INTERVAL=1m
EXPIRY_SECONDS=60
SIGNAL_LEAD_SECONDS=12
MIN_SETUP_SCORE=75.0
SCAN_INTERVAL_SECONDS=1.0

# Data Freshness & Quote Tolerances (seconds)
DATA_STALE_SECONDS=10.0
ENTRY_QUOTE_TOLERANCE_SECONDS=5.0
EXPIRY_QUOTE_TOLERANCE_SECONDS=10.0
RESULT_TIMEOUT_SECONDS=75.0

# Server & Safety Controls
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
KILL_SWITCH_ACTIVE=false
PAPER_MODE=true
